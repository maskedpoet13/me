# Copy to .env.local for local work. Never commit real values.
# In Netlify: Site configuration > Environment variables.

# Supabase project URL and the public "anon" (publishable) key.
# Safe for the browser. Row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The one email address allowed to sign in during Phase 1.
VITE_ALLOWED_EMAIL=

# Server only (Netlify Functions). NEVER prefix with VITE_.
# Used from Milestone 2 onward.
SUPABASE_SERVICE_ROLE_KEY=
